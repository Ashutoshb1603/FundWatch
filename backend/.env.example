# Groq fallback (used automatically when no AWS credentials are found)
# Set LLM_PROVIDER=groq or bedrock to force one.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# AWS credentials for Bedrock (or use `aws configure` / an instance role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1
# Must be a model your account has been granted access to in this region
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
